{
  "name": "astro-minimal-template",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "bun test tests/unit",
    "test:build": "node --test 'tests/build/*.test.ts' 'tests/demo/*.test.ts'",
    "build": "astro build",
    "verify:output": "bun scripts/verify-output.ts",
    "lint:html": "bun scripts/lint-html.ts",
    "lint:unused": "knip",
    "verify": "bun --bun run check && bun run lint:unused && bun run test && bun run test:build && bun --bun run build && bun --bun run verify:output && bun --bun run lint:html",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.6",
    "@types/node": "24.8.0",
    "deadhead": "0.4.0",
    "knip": "6.49.0",
    "parse5": "8.1.1",
    "satori": "0.63.2",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  }
}
